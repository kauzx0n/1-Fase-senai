programa {
  funcao inicio() {
    //informaçoes
    inteiro a,b
    //esntradas
    escreva("Digite o primeiro numero: ")
    leia(a)
     escreva("Digite o segundo numero: ")
    leia(b)
    //processamento e saida
    se(a > b){
    escreva("O primeiro numero é o maior " + a)
    }senao{
    se(b > a){
    escreva("O segundo numero é o maior " + b)
    }senao{
      escreva("Os dois são iguais")
    }

  }
}
}
