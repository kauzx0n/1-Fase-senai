programa {
  funcao inicio() {

    inteiro vitorias = 0
    inteiro empates = 0
    inteiro pontVitoria = 0
    inteiro pontos = 0

escreva("Digite as vitórias: ")
leia(vitorias)

escreva("Digite os empates: ")
leia(empates)

    pontVitoria = vitorias *3
    pontos = pontVitoria + empates
    escreva("O seu time tem o total de ")
  
  escreva(pontos)
 escreva(" pontos,")
 escreva(" Parabéns!!")
  }
}
