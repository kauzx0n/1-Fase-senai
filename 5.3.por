programa {
  funcao inicio() {
    inteiro placa 
    escreva("Digite o ultimo numero da placa: ")
    leia(placa)
    se(placa == 0 ou placa == 1){
      escreva("Nao pode na segunda")
    }senao se(placa == 2 ou placa == 3){
      escreva("Nao pode na terça")
    }senao se(placa == 4 ou placa == 5){
      escreva("Nao pode na quarta")
    }senao se(placa == 6 ou placa == 7){
      escreva("Nao pode na quinta")
    }senao se(placa == 8 ou placa == 9){
      escreva("Nao pode na sexta")
    }
  }
}
